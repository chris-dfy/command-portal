COMMAND_PORTAL_RUNTIME_API_BASE_URL=https://nexus-runtime-dev.fly.dev
COMMAND_PORTAL_RUNTIME_READ_TOKEN=<server-only-read-token>
COMMAND_PORTAL_RUNTIME_READ_TOKEN_REF=
COMMAND_PORTAL_RUNTIME_READ_TOKEN_KEY_ID=runtime-read-current
COMMAND_PORTAL_TRUST_BOOTSTRAP_REQUIRED=false
NEXUS_CONTEXT_ASSERTION_SECRET=<shared-runtime-context-assertion-secret-minimum-32-characters>
NEXUS_CONTEXT_ASSERTION_SECRET_REF=
NEXUS_CONTEXT_ASSERTION_KEY_ID=context-assertion-current
COMMAND_PORTAL_CONTEXT_ASSERTION_ISSUER=command-portal-experience-gateway
COMMAND_PORTAL_CONTEXT_ASSERTION_AUDIENCE=nexus-runtime
COMMAND_PORTAL_CONTEXT_ASSERTION_CLIENT_IDS=nexus-web
COMMAND_PORTAL_ALLOWED_ORIGINS=http://localhost:4173
COMMAND_PORTAL_REQUEST_TIMEOUT_MS=8000
COMMAND_PORTAL_REASONING_TIMEOUT_MS=35000
COMMAND_PORTAL_REALTIME_TIMEOUT_MS=25000
COMMAND_PORTAL_CACHE_TTL_MS=15000
COMMAND_PORTAL_MAX_RESPONSE_BYTES=1048576
COMMAND_PORTAL_LOCAL_CAPABILITIES_ENABLED=true
COMMAND_PORTAL_LOCAL_API_BASE_URL=http://127.0.0.1:8765
COMMAND_PORTAL_PLATFORM_RUNTIME_API_BASE_URL=http://127.0.0.1:8080
COMMAND_PORTAL_LOCAL_REQUEST_TIMEOUT_MS=30000
COMMAND_PORTAL_LOCAL_MAX_REQUEST_BYTES=37748736
COMMAND_PORTAL_LOCAL_MAX_RESPONSE_BYTES=5242880

# Operational Replay is independently disabled unless a sanitized Runtime projection is configured.
COMMAND_PORTAL_REPLAY_ENABLED=false
COMMAND_PORTAL_REPLAY_API_BASE_URL=http://127.0.0.1:4317
COMMAND_PORTAL_REPLAY_MAX_RESPONSE_BYTES=26214400

# Hosted Operational Gateway (single-workspace alpha; server-only)
COMMAND_PORTAL_OPERATIONAL_ENABLED=false
COMMAND_PORTAL_OPERATIONAL_API_BASE_URL=https://nexus-operations.example.com
COMMAND_PORTAL_OPERATIONAL_RUNTIME_TOKEN=<shared-server-runtime-token-minimum-24-characters>
COMMAND_PORTAL_SESSION_SECRET=<random-session-signing-secret-minimum-32-characters>
# Canonical human interaction requires access_key so the Gateway can bind one
# explicitly authenticated named operator. Private Replit ingress remains a
# network boundary; it does not establish human identity or approval Authority.
COMMAND_PORTAL_SESSION_MODE=access_key
COMMAND_PORTAL_OPERATOR_ACCESS_KEY=<single-operator-bootstrap-key-minimum-16-characters>
COMMAND_PORTAL_OPERATOR_USER_ID=<stable-named-operator-id>
COMMAND_PORTAL_TENANT_ID=nexicron
COMMAND_PORTAL_WORKSPACE_ID=primary
COMMAND_PORTAL_OPERATOR_ROLE=admin
COMMAND_PORTAL_OPERATIONAL_SCOPES=operations:read,operations:write,repository:metadata:read,approvals:decide,evidence:write,edge:node_admission:request
COMMAND_PORTAL_SESSION_TTL_SECONDS=3600
COMMAND_PORTAL_COOKIE_SECURE=true

# Registered Executive session (Mission 3; non-production; server-only)
COMMAND_PORTAL_EXECUTIVE_SESSION_ENABLED=false
COMMAND_PORTAL_EXECUTIVE_SESSION_TTL_SECONDS=3600
COMMAND_PORTAL_EXECUTIVE_SESSION_COOKIE_SECRET=<purpose-bound-cookie-secret-minimum-32-characters>
COMMAND_PORTAL_EXECUTIVE_SESSION_COOKIE_SECRET_REF=<provider-secret-reference>
COMMAND_PORTAL_EXECUTIVE_SESSION_COOKIE_KEY_ID=executive-session-cookie-current
NEXUS_HUMAN_SESSION_ASSERTION_SECRET=<purpose-bound-runtime-assertion-secret-minimum-32-characters>
NEXUS_HUMAN_SESSION_ASSERTION_SECRET_REF=<provider-secret-reference>
NEXUS_HUMAN_SESSION_ASSERTION_KEY_ID=executive-session-current
COMMAND_PORTAL_HUMAN_SESSION_ASSERTION_ISSUER=command-portal-experience-gateway
COMMAND_PORTAL_HUMAN_SESSION_ASSERTION_AUDIENCE=nexus-runtime
COMMAND_PORTAL_HUMAN_SESSION_ASSERTION_TTL_SECONDS=60
COMMAND_PORTAL_HUMAN_SESSION_SERVICE_BINDING_ID=command-portal-experience-gateway
COMMAND_PORTAL_HUMAN_SESSION_ASSERTION_CLIENT_ID=nexus-web
COMMAND_PORTAL_REPLIT_AUTH_ISSUER=https://replit.com/oidc
COMMAND_PORTAL_REPLIT_AUTH_AUDIENCE=<provider-owned-REPL_ID>
# Agent-provisioned interactive Replit Auth. This can be enabled while the
# Registered Executive session remains disabled for a fail-closed bootstrap.
COMMAND_PORTAL_PROVIDER_INTERACTIVE_AUTH_ENABLED=false
COMMAND_PORTAL_PROVIDER_SESSION_SECRET=<purpose-bound-provider-session-seal-secret-minimum-32-characters>
COMMAND_PORTAL_PROVIDER_SESSION_SECRET_REF=<provider-secret-reference>
COMMAND_PORTAL_PROVIDER_SESSION_KEY_ID=provider-session-current
COMMAND_PORTAL_PROVIDER_SESSION_TTL_SECONDS=3600
# These fields are only for the separately tested legacy JWT/JWKS fallback.
COMMAND_PORTAL_REPLIT_AUTH_JWKS_URL=
COMMAND_PORTAL_REPLIT_AUTH_TOKEN_HEADER=x-replit-auth-token
COMMAND_PORTAL_REPLIT_AUTH_CLOCK_SKEW_SECONDS=30
COMMAND_PORTAL_REPLIT_AUTH_MAX_TOKEN_LIFETIME_SECONDS=3600
COMMAND_PORTAL_REPLIT_AUTH_JWKS_TIMEOUT_MS=5000
COMMAND_PORTAL_REPLIT_AUTH_JWKS_CACHE_SECONDS=300
COMMAND_PORTAL_EXECUTIVE_REGISTRATIONS_JSON=<server-owned-registered-executive-principal-registry-json>
COMMAND_PORTAL_EXECUTIVE_SESSION_POLICY_ID=registered-executive-session-policy
COMMAND_PORTAL_EXECUTIVE_SESSION_POLICY_VERSION=1.0.0
COMMAND_PORTAL_EXECUTIVE_SESSION_POLICY_DIGEST=sha256:b1f6a2cdf2153ac48236867e5e1aeab794842256410f3f314fc2655008a2be78

# Configure the bearer transport principal and authoritative v3 assertion
# allowlists on Runtime. Human identity comes from the signed assertion, not the
# bearer principal or browser body.
# NEXUS_HOSTED_SERVICE_ID=nexus-workspace-service
# NEXUS_CONTEXT_ASSERTION_ISSUERS=command-portal-experience-gateway
# NEXUS_CONTEXT_ASSERTION_CLIENT_IDS=nexus-web
PORT=4173

# Runtime configuration is server-only. Local capability mode accepts loopback targets only.
# Never define a VITE_ Runtime variable or credential.
