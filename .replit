run = "npm run start"
entrypoint = "server/index.mjs"
modules = ["nodejs-20"]

[deployment]
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm run start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 4173
externalPort = 80

[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
COMMAND_PORTAL_RUNTIME_API_BASE_URL = "https://nexus-runtime-dev.fly.dev"
COMMAND_PORTAL_TRUST_BOOTSTRAP_REQUIRED = "true"
COMMAND_PORTAL_RUNTIME_READ_TOKEN_KEY_ID = "runtime-read-current"
COMMAND_PORTAL_RUNTIME_READ_TOKEN_REF = "secret-manager:experience-gateway/mission-1/runtime-read-current"
COMMAND_PORTAL_CONTEXT_ASSERTION_ISSUER = "command-portal-experience-gateway"
COMMAND_PORTAL_CONTEXT_ASSERTION_AUDIENCE = "nexus-runtime"
COMMAND_PORTAL_CONTEXT_ASSERTION_CLIENT_IDS = "nexus-web"
NEXUS_CONTEXT_ASSERTION_KEY_ID = "context-assertion-current"
NEXUS_CONTEXT_ASSERTION_SECRET_REF = "secret-manager:experience-gateway/mission-1/context-assertion-current"
COMMAND_PORTAL_OPERATIONAL_API_BASE_URL = "https://nexus-runtime-dev.fly.dev"
COMMAND_PORTAL_OPERATIONAL_ENABLED = "true"
COMMAND_PORTAL_OPERATIONAL_SCOPES = "operations:read,operations:write,actions:simulate,evidence:write,edge:node_admission:request"
COMMAND_PORTAL_OPERATOR_ROLE = "operator"
COMMAND_PORTAL_OPERATOR_USER_ID = "nexus-workspace-service"
COMMAND_PORTAL_TENANT_ID = "nexicron"
COMMAND_PORTAL_WORKSPACE_ID = "primary"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
